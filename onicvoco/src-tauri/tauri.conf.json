{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnicVoco",
  "version": "0.1.0",
  "identifier": "com.onicvoco.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OnicVoco",
        "width": 1180,
        "height": 820,
        "minWidth": 400,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Gentle, private voice training",
    "longDescription": "OnicVoco helps you practise your voice with a live pitch meter, scientific pitch notation, a resonance estimate, progress history and an optional on-device AI coach.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-pulseaudio"
        ]
      }
    }
  }
}